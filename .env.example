# === Database ===
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
DATABASE_PORT=5432


# === Database URLs (source of truth for db:use:*) ===
DATABASE_URL_POSTGRES=postgresql://user:password@localhost:5432/your_db?schema=public
DATABASE_URL_SQLITE=file:./dev.db

# Run `npm run db:use:postgres` once after copying this file.
# That command populates DB_PROVIDER and DATABASE_URL (Prisma needs both).


# === App ===
NODE_ENV=development
APPLICATION_PORT=3000
BETTER_AUTH_URL=http://localhost:3000

# === Better Auth ===
# Generate a fresh value: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_TO_RANDOM_32_BYTES
COOKIE_PREFIX=arete

# === CORS (comma-separated) ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# === File storage ===
HOST_MACHINE_FILE_STORAGE_PATH=/absolute/path/on/host/uploads
CONTAINER_FILE_STORAGE_PATH=/usr/src/app/uploads
MAX_PAYLOAD_SIZE=52428800