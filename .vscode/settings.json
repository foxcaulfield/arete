{
    "[env]": {
        "editor.defaultFormatter": "IronGeek.vscode-env",
        "editor.formatOnSave": true
    },
    // "files.associations": {
    //     "*.njk": "html"
    // },
    // "emmet.includeLanguages": {
    //     "njk": "html",
    //     "jinja": "html",
    //     "html": "html",
    //     "nunjucks": "html",
    //     "jinja-html": "html",
    //     "html-nunjucks": "html",
    //     "htmlnunjucks": "html",
    //     "html.njk": "html"
    // },
    "files.associations": {
        "*.njk": "html",
        "*.css": "tailwindcss",
        ".env": "env",
        ".env.*": "env",
        "*.env": "env",
        ".env.local": "env",
        ".env.development": "env",
        ".env.production": "env"
    },
    "emmet.includeLanguages": {
        "njk": "html"
    },
    "prettier.documentSelectors": [
        "**/*.njk"
    ],
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    // default njk formatter to prettier
    "html.customData": [
        "./.vscode/htmx-custom-data.json"
    ],
    "html.validate.scripts": false,
    // "prettier.embeddedLanguageFormatting": "off",
    // "editor.semanticHighlighting.enabled": true,
    "workbench.colorCustomizations": {
        "window.activeBorder": "#00FF00", // Bright Green for active window
        "editorGroup.border": "#FF0000", // Red border between editor panels
        "contrastBorder": "#888888", // Light gray for general contrast borders
        // "tab.border": "#0000FF" // Blue border for tabs
        "panel.border": "#FF0000", // Red border for bottom panel
        // 1. ВАШЕ АКТИВНОЕ ВЫДЕЛЕНИЕ (Делаем максимально ярким и непрозрачным)
        "editor.selectionBackground": "#ff00808e",
        "editor.selectionForeground": "#FFFFFF",
        // 2. ПОДСВЕТКА ОДИНАКОВЫХ СЛОВ (Когда просто поставили курсор на слово)
        // Делаем цвет блеклым/прозрачным, чтобы при выделении мышью оно перекрывалось основным цветом
        "editor.wordHighlightBackground": "#3399FF33",
        "editor.wordHighlightBorder": "#3399FF88",
        "editor.wordHighlightStrongBackground": "#00FF6633", // Для переменных на запись
        "editor.wordHighlightStrongBorder": "#00FF6688",
        // 3. РЕЗУЛЬТАТЫ ПОИСКА ЧЕРЕЗ CTRL+F (Тоже могут перекрывать выделение)
        // Текущее найденное слово, на котором стоит фокус поиска:
        "editor.findMatchBackground": "#FFCC00AA",
        // Все остальные найденные совпадения на странице (делаем прозрачнее):
        "editor.findMatchHighlightBackground": "#FFCC0033",
        "editor.findMatchHighlightBorder": "#FFCC0066",
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "entity.name.tag.njk",
                    "punctuation.tag.njk",
                    "punctuation.definition.tag.begin.njk",
                    "punctuation.definition.tag.end.njk"
                ],
                "settings": {
                    "foreground": "#C678DD",
                    "fontStyle": ""
                }
            },
            {
                "scope": [
                    "variable.other.njk",
                    "meta.output.njk"
                ],
                "settings": {
                    "foreground": "#ffd866"
                }
            },
            {
                "scope": [
                    "text.html.derivative meta.block.njk",
                    "meta.block.njk",
                    "keyword.control.njk",
                    "punctuation.definition.template.njk",
                    "punctuation.definition.template.begin.njk",
                    "punctuation.definition.template.end.njk",
                    "punctuation.section.embedded.begin.njk",
                    "punctuation.section.embedded.end.njk"
                ],
                "settings": {
                    "foreground": "#ff5f87",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "comment.block.njk",
                    "comment.line.njk"
                ],
                "settings": {
                    "foreground": "#40464d",
                    "fontStyle": "italic"
                }
            }
        ]
    },
    "files.exclude": {
        "public/app/**": true,
        "dist/**": true,
        "node_modules/**": true,
        "src/generated/**": true
    },
    "search.exclude": {
        "public/app/**": true,
        "dist/**": true,
        "src/generated/**": true
    },
    "files.watcherExclude": {
        "**/public/app/**": true,
        "**/dist/**": true,
        "**/src/generated/**": true
    },
    "prisma.pinToPrisma6": true
}