{
	"name": "arete",
	"version": "2.0.5-rc.1",
	"description": "",
	"author": "foxcaulfield",
	"private": true,
	"license": "SEE LICENSE IN LICENSE FILE",
	"scripts": {
		"build": "npm run build:front && nest build",
		"build:front": "vite build --config front-end/vite.config.mts",
		"start": "nest start",
		"start:dev:db": "docker compose up db",
		"start:dev:backend": "nest start --watch",
		"start:dev:front": "vite --config front-end/vite.config.mts",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main.js",
		"start:migrate:prod": "prisma migrate deploy && npm run start:prod",
		"dev:db": "docker compose up -d db",
		"dev:stop": "docker compose down",
		"dev:status": "docker compose ps",
		"dev:logs": "docker compose logs -f backend",
		"verify:prod": "npm run build && npm run start:prod",
		"verify:docker": "docker compose down && docker compose up --build",
		"verify:docker:fresh": "docker compose down && docker compose build --no-cache && docker compose up",
		"backup": "mkdir -p data/backups && npm run db:use:postgres && npm run db:export && mv data/export.json \"data/backups/$(date +%Y%m%d-%H%M%S).json\"",
		"db:use:postgres": "node scripts/db-use.mjs postgres",
		"db:use:sqlite": "node scripts/db-use.mjs sqlite",
		"db:export": "node scripts/db-export.mjs",
		"db:import": "node scripts/db-import.mjs",
		"db:import:merge": "node scripts/db-import.mjs --merge",
		"db:combine": "node scripts/db-combine.mjs",
		"db:clone:pg-to-sqlite": "node scripts/db-clone.mjs pg-to-sqlite",
		"db:counts": "docker compose exec -T db psql -U postgres -d arete -c \"SELECT 'exercises' AS tbl, COUNT(*) FROM exercises UNION ALL SELECT 'collections', COUNT(*) FROM collections UNION ALL SELECT 'attempts', COUNT(*) FROM attempts UNION ALL SELECT 'users', COUNT(*) FROM users;\"",
		"db:dump": "docker exec arete-db-1 pg_dump -U postgres -F c arete > arete_backup_$(date +%F).dump",
		"prisma:generate": "prisma generate",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"release": "bash scripts/release.sh",
		"dev": "bash scripts/dev.sh",
		"launch:prod:pg": "bash scripts/launch-prod-pg.sh",
		"launch:prod:pg:fresh": "bash scripts/launch-prod-pg.sh --fresh",
		"launch:prod:pg:logs": "bash scripts/launch-prod-pg.sh --foreground",
		"launch:prod:sqlite": "bash scripts/launch-prod-sqlite.sh",
		"audit": "npm audit --omit=dev",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\""
	},
	"dependencies": {
		"@better-auth/prisma-adapter": "^1.7.12",
		"@getlarge/nestjs-tools-file-storage": "^1.4.2",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.1",
		"@nestjs/mapped-types": "^2.1.0",
		"@nestjs/platform-express": "^11.2.8",
		"@nestjs/schedule": "^6.0.1",
		"@nestjs/serve-static": "^5.0.4",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/client": "^6.19.3",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@thallesp/nestjs-better-auth": "^2.8.0",
		"@zerodevx/svelte-toast": "^0.9.6",
		"argon2": "^0.44.0",
		"better-auth": "^1.7.12",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"date-fns": "^4.1.0",
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"joi": "^18.0.1",
		"markdown-it": "^15.0.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@lucide/svelte": "^1.61.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^10.0.4",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.6",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^11.0.7",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/markdown-it": "^14.2.0",
		"@types/multer": "^2.0.0",
		"@types/node": "^22.20.5",
		"@types/supertest": "^6.0.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^16.0.0",
		"jest": "^30.0.0",
		"prettier": "^3.6.2",
		"prisma": "^6.19.3",
		"semantic-release": "^24.2.9",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0",
		"vite": "^8.3.4"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	},
	"overrides": {
		"multer": "^2.4.1"
	}
}
